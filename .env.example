# UrbanHub - Environment Variables
# Copy this file to .env and fill in the values

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=urbanhub
POSTGRES_USER=urbanhub
POSTGRES_PASSWORD=changeme

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Data directories
DATA_DIR=./data
RAW_DIR=./data/raw
BRONZE_DIR=./data/bronze
SILVER_DIR=./data/silver
GOLD_DIR=./data/gold

# Logs
LOG_DIR=./logs
LOG_LEVEL=INFO

# API Settings
NOAA_BASE_URL=https://www.ncei.noaa.gov/data/global-hourly/access/
CITYBIKES_API_URL=https://api.citybik.es/v2/
OPENAQ_API_URL=https://api.openaq.org/v2/

# Scheduler Settings
SCHEDULER_INTERVAL_BIKES=60  # seconds
SCHEDULER_INTERVAL_POLLUTION=600  # seconds
