# UrbanHub - Environment Variables Template
# Copy this file to .env and fill in your values
# IMPORTANT: Do NOT commit .env to version control!

# ============================================
# DATABASE (Optional - not required for basic usage)
# ============================================
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=urbanhub
# POSTGRES_USER=urbanhub
# POSTGRES_PASSWORD=your_secure_password

# ============================================
# REDIS (Optional - for caching)
# ============================================
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0

# ============================================
# DATA DIRECTORIES
# ============================================
DATA_DIR=./data
RAW_DIR=./data/raw
BRONZE_DIR=./data/bronze
SILVER_DIR=./data/silver
GOLD_DIR=./data/gold

# ============================================
# LOGGING
# ============================================
LOG_DIR=./logs
LOG_LEVEL=INFO

# ============================================
# API KEYS AND ENDPOINTS
# ============================================

# OpenAQ API Key (get free key at https://openaq.org/)
# OPENAQ_API_KEY=your_openaq_api_key_here

# ============================================
# COLLECTION INTERVALS (in seconds)
# ============================================
SCHEDULER_INTERVAL_BIKES=600    # 10 minutes (avoid rate limiting)
SCHEDULER_INTERVAL_POLLUTION=3600  # 1 hour

# ============================================
# WEATHER DATA
# ============================================
# NOAA data is downloaded from public URL, no API key needed
NOAA_BASE_URL=https://www.ncei.noaa.gov/data/global-hourly/access/
